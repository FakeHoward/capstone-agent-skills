{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://capstone-agent-skills.local/schemas/triggers.schema.json",
  "title": "Capstone agent skills triggers",
  "type": "object",
  "required": ["version", "triggers"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["skill", "required_terms", "blind_prompts"],
        "additionalProperties": true,
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "required_terms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "blind_prompts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
