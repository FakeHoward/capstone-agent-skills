{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://capstone-agent-skills.local/schemas/pointers.schema.json",
  "title": "Capstone agent skills fixture pointers",
  "type": "object",
  "required": ["version", "pointers"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "pointers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "hex", "expected", "skill"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string" },
          "skill": { "type": "string", "minLength": 1 },
          "arch": { "type": "string" },
          "mode": { "type": "string" },
          "upstream": { "type": "string" },
          "hex": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
