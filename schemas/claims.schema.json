{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://capstone-agent-skills.local/schemas/claims.schema.json",
  "title": "Capstone agent skills claims",
  "type": "object",
  "required": ["version", "claims"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_path", "regex"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "skill": { "type": "string" },
          "risk": { "type": "string" },
          "statement": { "type": "string" },
          "source_path": { "type": "string", "minLength": 1 },
          "regex": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
